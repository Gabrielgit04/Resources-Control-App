# Copia este archivo a `.env` y rellena los valores (NUNCA subas `.env` a git).

# Supabase (proyecto)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# JWKS de Supabase para validar JWT en Edge Functions
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# Superadmin (tu UUID de auth.users) — SOLO para Edge Functions
SUPERADMIN_USER_ID=TU_UUID_SUPERADMIN
# La misma UUID expuesta al cliente para mostrar el módulo de administración
VITE_SUPERADMIN_USER_ID=TU_UUID_SUPERADMIN
