# Copia este archivo a `.env` y rellena los valores (NUNCA subas `.env` a git).

# Supabase (proyecto)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# (Opcional) Las Edge Functions derivan la URL de JWKS de SUPABASE_URL automáticamente.
# Solo define SUPABASE_JWKS_URL si necesitas apuntar a otro endpoint:
# SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# Superadmin (tu UUID de auth.users) — SOLO para Edge Functions (nunca llega al cliente)
SUPERADMIN_USER_ID=TU_UUID_SUPERADMIN
